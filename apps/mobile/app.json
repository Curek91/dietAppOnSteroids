{
  "expo": {
    "name": "DietApp",
    "slug": "dietapp",
    "version": "0.1.0",
    "scheme": "dietapp",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#f97316",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pl.dietapp.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacja używa aparatu do robienia zdjęć posiłków.",
        "NSHealthShareUsageDescription": "Aplikacja czyta dane treningu i regeneracji z Apple Watch.",
        "NSPhotoLibraryUsageDescription": "Aplikacja zapisuje zdjęcia posiłków w galerii."
      }
    },
    "android": {
      "package": "pl.dietapp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#fafaf9"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
